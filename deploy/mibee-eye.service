[Unit]
Description=MiBee Eye - ONVIF Camera Server
After=network.target
# No explicit StartLimit*: with RestartSec=5 the default 10s/5-start
# window is unreachable, so deliberate self-restarts (config save, rotate,
# imaging flips — SPEC 附录A #9) can slow the service but never hit
# start-limit — which has no auto-recovery and leaves the camera dead
# until a human intervenes. Matches the rs unit's posture.
Conflicts=mediamtx.service

[Service]
Type=simple
User=pi
Environment=LD_LIBRARY_PATH=/home/pi/mibee-eye/deploy/bin
Environment=LIBCAMERA_IPA_CONFIG_PATH=/usr/share/libcamera/ipa
WorkingDirectory=/home/pi/mibee-eye
ExecStart=/home/pi/mibee-eye/mibee-eye -config /home/pi/mibee-eye/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
