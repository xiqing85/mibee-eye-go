# MiBee Eye (Go) — systemd unit for the alternate host (rpi3b-cam).
#
# Device layout on this host differs from the canonical ~/mibee-eye
# layout in mibee-eye.service: binary ~/rpi3b-cam/mibee-eye (the packaged
# name — never a host-specific binary name),
# config ~/rpi3b-cam/configs/config.yaml (the -config flag default is
# relative to WorkingDirectory), recordings under ~/rpi3b-cam/recordings.
# Camera mode is rpicamvid (system rpicam-vid) — no LD_LIBRARY_PATH needed.
#
# Install:
#   scp deploy/mibee-eye-118.service pi@192.168.1.100:/tmp/
#   ssh pi@192.168.1.100 'sudo mv /tmp/mibee-eye-118.service /etc/systemd/system/mibee-eye.service && sudo systemctl daemon-reload && sudo systemctl enable --now mibee-eye'
[Unit]
Description=MiBee Eye - ONVIF Camera Server (Go)
After=network-online.target
Wants=network-online.target
# No explicit StartLimit*: with RestartSec=5 the default 10s/5-start
# window is unreachable, so deliberate self-restarts (config save, rotate,
# imaging flips — SPEC 附录A #9) can slow the service but never hit
# start-limit — which has no auto-recovery and leaves the camera dead
# until a human intervenes. Matches the rs unit's posture.

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/rpi3b-cam
ExecStart=/home/pi/rpi3b-cam/mibee-eye
Restart=always
RestartSec=5
# Camera access (rpicam-vid / /dev/video0).
SupplementaryGroups=video
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
